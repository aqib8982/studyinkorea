# Study In Korea: server rules for Hostinger (Apache / LiteSpeed). Generated into dist/ by build.py.

Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/webp .webp

# 1. Always HTTPS, always www. aqibinkorea.com goes straight to https://www (one redirect).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^aqibinkorea\.com$ [NC]
  RewriteRule ^ https://www.aqibinkorea.com%{REQUEST_URI} [L,R=301,NE]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
</IfModule>

# 2. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml image/x-icon
</IfModule>

# 3. Caching
<IfModule mod_headers.c>
  # pages and small root files: always check for a newer version
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # icons and the sharing image keep fixed names: one week
  <FilesMatch "^(favicon\.(ico|svg)|apple-touch-icon\.png|icon-(192|512)\.png|social-card\.jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # files with a content hash in the name never change: one year
  <FilesMatch "\.[0-9a-f]{10}\.(css|js|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
